# Secrets and per-machine settings for the Production & Inventory Tracker API.
# This file lists the NAMES only. Never put real values in a committed file (PRD AC-02.5).
#
# The application reads these from environment variables, or in Development from `dotnet user-secrets`
# (see docs/03-architecture.md section 7). It does not read a .env file itself; copy this file to `.env`
# (git-ignored) only as your own private note or for tools such as Docker that read it.

# Email of the first Manager, created only when the database has no users (US-02).
ADMIN_EMAIL=

# Password of the first Manager: at least 8 characters with an upper-case letter, a lower-case letter and a digit.
ADMIN_PASSWORD=

# Secret key that signs the sign-in tokens (JWT, HMAC-SHA256). A random string of at least 32 characters.
JWT_SIGNING_KEY=
