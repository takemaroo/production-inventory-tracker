# Secrets and per-machine settings for the Production & Inventory Tracker API.
# This file lists the NAMES only. Never put real values in a committed file (PRD AC-02.5).
#
# The application reads these from environment variables, or in Development from `dotnet user-secrets`
# (see docs/03-architecture.md section 8 and docs/07-release.md section 3). It never reads a .env file itself,
# and neither do the scripts in scripts/.
#
# The one tool that does read a .env file is the sample-requests file src/InventoryTracker.Api/InventoryTracker.Api.http:
# it reads ADMIN_EMAIL, ADMIN_PASSWORD and the three SAMPLE_USER_ passwords (bottom of this file) with {{$dotenv ...}}
# from src/InventoryTracker.Api/.env
# (next to the .http file), NOT from a .env at the repository root. Both .env files are git-ignored.

# --- Required ---------------------------------------------------------------------------------------------------

# Email of the first Manager, created only when the database has no users (US-02). Ignored afterwards.
ADMIN_EMAIL=

# Password of the first Manager: at least 8 characters with an upper-case letter, a lower-case letter and a digit.
# Needed only for the first start. Change the password after the first sign-in, then remove this variable.
ADMIN_PASSWORD=

# Secret key that signs the sign-in tokens (JWT, HMAC-SHA256). At least 32 characters; required on every start.
# Generate a random one per machine with scripts/new-signing-key.ps1. Never a phrase, never shared between instances.
JWT_SIGNING_KEY=

# --- Optional (the defaults are in src/InventoryTracker.Api/appsettings.json) -------------------------------------

# SQLite connection string with an absolute path. scripts/run.ps1 defaults to
# Data Source=%LOCALAPPDATA%\InventoryTracker\inventory.db when this is not set.
ConnectionStrings__Default=

# Tolerance percentage for sends and usage variance, 0 to 100 (default 2). Outside that range the API will not start.
Inventory__TolerancePercent=

# Hours a sign-in token stays valid (default 8, AC-01.2).
Jwt__TokenLifetimeHours=

# Environment name. scripts/run.ps1 always sets Production; `dotnet run` without --no-launch-profile uses Development.
ASPNETCORE_ENVIRONMENT=

# --- Sample requests only (src/InventoryTracker.Api/.env; the API never reads these) --------------------------------
# InventoryTracker.Api.http also reads ADMIN_EMAIL and ADMIN_PASSWORD above for its sign-in request. These three are
# the passwords of the Warehouse user its section 11 creates, resets and changes, against a Development database only.
# Each must pass the password policy above, and the three must differ.

# Password the sample user is created with (POST /users).
SAMPLE_USER_PASSWORD=

# Password a Manager resets the sample user's password to (PUT /users/{id}/password); the user then signs in with it.
SAMPLE_USER_RESET_PASSWORD=

# Password the sample user changes their own password to (POST /auth/change-password).
SAMPLE_USER_NEW_PASSWORD=
