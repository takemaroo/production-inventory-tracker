{
  // TypeScript settings for the front end. TypeScript only checks the code here ("noEmit"): Vite turns the
  // .ts and .tsx files into browser JavaScript when it builds or serves them (docs/03-architecture.md, part v1.2).
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    // The strictest checks that stay practical: they catch null mistakes and missing cases before the code runs.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Each file must be understandable on its own, which is how Vite compiles it.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts"]
}
